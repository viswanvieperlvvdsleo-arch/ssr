generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model CMSContent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  type      String   @default("general")
  isFollowedUp Boolean @default(false)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isFollowedUp Boolean @default(false)
  createdAt DateTime @default(now())
}

model Availability {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)
  booking   Booking?
}

model Booking {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  visitorName    String
  visitorEmail   String?
  visitorPhone   String?
  purpose        String?
  availabilityId String       @unique @db.ObjectId
  availability   Availability @relation(fields: [availabilityId], references: [id])
  isFollowedUp   Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model RegisteredUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  phone     String
  module    String   @default("Not selected")
  isFollowedUp Boolean @default(false)
  createdAt DateTime @default(now())
}
